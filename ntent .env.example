[32m+[m
[32m+[m[32m# Cloudinary Cloud Object Storage (Required if STORAGE_TYPE=cloudinary)[m
[32m+[m[32mCLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name[m
