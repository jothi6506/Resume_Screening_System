FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# ── CENTRALIZED CLOUD DATABASE CONFIGURATION ─────────────────────────────────
# Local Development: mysql+pymysql://root:password@localhost:3306/resume_screening
# Production Cloud DB (Aiven, TiDB Cloud, Railway, AWS RDS):
# DATABASE_URL=mysql+pymysql://username:password@cloud-db-host.com:3306/resume_screening
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/resume_screening

# ── RESUME OBJECT STORAGE CONFIGURATION ─────────────────────────────────────
# Options: 'local', 's3', 'cloudinary'
STORAGE_TYPE=local

# AWS S3 Cloud Object Storage (Required if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=your_resume_bucket_name
AWS_REGION=us-east-1

# Cloudinary Cloud Object Storage (Required if STORAGE_TYPE=cloudinary)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# File upload limits
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads/resumes

# ── SEED ADMIN CREDS ────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@resume.local
SEED_ADMIN_PASSWORD=Admin@123

# ── GMAIL SMTP NOTIFICATIONS ────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_gmail@gmail.com

# ── RECRUITMENT AI KEYS (OPTIONAL) ───────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
